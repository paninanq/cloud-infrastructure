{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "victoria-metrics"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 95}, {"color": "green", "value": 99.9}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "100 * sum(up) / clamp_min(count(up), 1)", "refId": "A"}],
      "title": "Scrape target availability", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoria-metrics"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "count(up == 0)", "refId": "A"}],
      "title": "Unavailable targets", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoria-metrics"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 104857600}, {"color": "red", "value": 1073741824}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(vmagent_remotewrite_pending_data_bytes)", "refId": "A"}],
      "title": "Remote-write backlog", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoria-metrics"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(rate(vmagent_remotewrite_errors_total[5m]))", "refId": "A"}],
      "title": "Remote-write errors / sec", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoria-metrics"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (job) (up)", "legendFormat": "{{job}}", "refId": "A"}],
      "title": "Healthy scrape targets by job", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoria-metrics"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(rate(vm_promscrape_scrapes_failed_total[5m]))", "legendFormat": "failed scrapes", "refId": "A"},
        {"expr": "sum(rate(vmagent_remotewrite_retries_count_total[5m]))", "legendFormat": "remote-write retries", "refId": "B"}
      ],
      "title": "Collection and delivery errors", "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["victoriametrics", "pipeline", "ops"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Monitoring Pipeline",
  "uid": "pochini-monitoring-pipeline",
  "version": 1
}
